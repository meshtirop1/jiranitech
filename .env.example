# =============================================================================
# Jiranisoko Tech Solutions — environment template
#
# Copy to .env and fill in. On cPanel, set APP_ENV=production and APP_DEBUG=false
# before the site is reachable: a stack trace on a public URL discloses paths,
# configuration and query structure.
# =============================================================================

APP_NAME="Jiranisoko Tech Solutions"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tech.jiranisoko.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Africa/Nairobi

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Database — cPanel MySQL
# Create the database and user in cPanel > MySQL Databases, grant ALL PRIVILEGES,
# then paste the fully prefixed names below (cPanel prefixes both with the account
# name, e.g. jirani_tech and jirani_techuser).
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Sessions, cache and queue
# All database-backed so no Redis, Memcached or queue worker is required. The
# necessary tables are created by the standard migrations. Keep QUEUE_CONNECTION
# as sync unless you have configured a cron-driven worker.
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Mail — cPanel account mailbox
# Create the mailbox in cPanel > Email Accounts, then use its credentials.
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mail.jiranisoko.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@jiranisoko.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Corporate identity — publication gate G-07
#
# The registered office, company registration number and a named contact route are
# mandatory before launch. Their absence is a documented disqualifier in
# institutional and public-sector vendor screening, and the footer renders a
# visible marker on every page until these are set.
# -----------------------------------------------------------------------------
COMPANY_LEGAL_NAME="Jiranisoko Tech Solutions"
COMPANY_PARENT_NAME="Jiranisoko Market Ltd"
COMPANY_PARENT_URL="https://jiranisoko.com"

COMPANY_REGISTERED_ADDRESS=
COMPANY_REGISTRATION_NUMBER=
COMPANY_CITY="Eldoret"
COMPANY_COUNTRY="Kenya"

COMPANY_EMAIL_ENQUIRIES=
COMPANY_EMAIL_RFP=
COMPANY_EMAIL_SECURITY=
COMPANY_TELEPHONE=

COMPANY_CLIENT_PORTAL_URL=

VITE_APP_NAME="${APP_NAME}"
