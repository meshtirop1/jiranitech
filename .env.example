# =============================================================================
# Jiranisoko Tech Solutions — environment template
#
# Copy to .env and fill in. On cPanel, set APP_ENV=production and APP_DEBUG=false
# before the site is reachable: a stack trace on a public URL discloses paths,
# configuration and query structure.
# =============================================================================

APP_NAME="Jiranisoko Tech Solutions"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tech.jiranisoko.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Africa/Nairobi

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Database
#
# SQLite is what is deployed. It needs no credentials, which matters on a host
# where creating a MySQL user means setting a password by hand, and it is more
# than adequate for a brochure site plus RFP intake. The file must sit OUTSIDE
# the web root.
#
# MySQL is also free on cPanel if you want phpMyAdmin access or easier backups.
# Create the database and user in cPanel > MySQL Databases, then swap the block
# below for the commented one and re-run migrations.
# -----------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=/home2/sokojira/jiranisoko-tech/database/database.sqlite

# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

# -----------------------------------------------------------------------------
# Sessions, cache and queue
# All database-backed so no Redis, Memcached or queue worker is required. The
# necessary tables are created by the standard migrations. Keep QUEUE_CONNECTION
# as sync unless you have configured a cron-driven worker.
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Mail
#
# sendmail, not SMTP. On cPanel the application hands the message to the local
# Exim as the account user, so there is no mailbox password in this file, nothing
# to rotate when a mailbox password changes, and no SMTP round trip inside the
# request. Exim applies the domain's existing DKIM key on the way out, and the
# SPF record already authorises this server, so the message authenticates.
#
# MAIL_HOST/PORT/USERNAME/PASSWORD are unused by the sendmail transport and are
# left here only for a host that ever forces SMTP relaying.
# -----------------------------------------------------------------------------
MAIL_MAILER=sendmail
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
MAIL_HOST=
MAIL_PORT=
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@jiranisokotech.co.ke
MAIL_FROM_NAME="Jiranisoko Tech Solutions"

# -----------------------------------------------------------------------------
# Corporate identity — publication gate G-07
#
# Entity model. Keep these three apart:
#   Jiranisoko Market Ltd       the holding company (registered)
#   Jiranisoko Tech Solutions   this site, a division - NOT separately incorporated
#   JiraniSoko Marketplace      a sibling consumer platform at jiranisoko.com
#
# COMPANY_PARENT_URL is the holding company's own corporate site. Leave it EMPTY
# until one exists: the "Investor & Group" link then resolves to this site's group
# section instead of sending a procurement reviewer to a consumer marketplace.
# Never point it at COMPANY_MARKETPLACE_URL.
# -----------------------------------------------------------------------------
COMPANY_LEGAL_NAME="Jiranisoko Tech Solutions"

COMPANY_PARENT_NAME="Jiranisoko Market Ltd"
COMPANY_PARENT_URL=
COMPANY_PARENT_REGISTRATION_NUMBER="PVT-YQ195JQY"
COMPANY_PARENT_TAX_PIN="P052526482R"
COMPANY_PARENT_INCORPORATED_ON="2026-03-30"

COMPANY_MARKETPLACE_NAME="JiraniSoko Marketplace"
COMPANY_MARKETPLACE_URL="https://jiranisoko.com"

# From the CR12 (official search, PVT-YQ195JQY) and corroborated by the KRA PIN
# certificate. Street-level line only: the footer and the schema.org graph append
# CITY and COUNTRY, so repeating them here would print them twice.
COMPANY_REGISTERED_ADDRESS="Building 12, Soy-Kabenes Road, Eldoret West"
COMPANY_POSTAL_ADDRESS="P.O. Box 91-30105, Soy"
COMPANY_CITY="Eldoret"
COMPANY_COUNTRY="Kenya"

COMPANY_EMAIL_ENQUIRIES="info@jiranisokotech.co.ke"
COMPANY_EMAIL_RFP="proposals@jiranisokotech.co.ke"
COMPANY_EMAIL_SECURITY="security@jiranisokotech.co.ke"
COMPANY_TELEPHONE=

COMPANY_CLIENT_PORTAL_URL=

VITE_APP_NAME="${APP_NAME}"

COMPANY_EMAIL_CAREERS="careers@jiranisokotech.co.ke"
COMPANY_EMAIL_PRIVACY="privacy@jiranisokotech.co.ke"

# Delivery system. Bound to its own hostname; unset locally so the routes
# answer under /erp on whatever host the dev server uses.
ERP_DOMAIN="erp.jiranisokotech.co.ke"
ERP_NAME="Jiranisoko Delivery"